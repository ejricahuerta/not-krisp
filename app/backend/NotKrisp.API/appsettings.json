{
  "ConnectionStrings": {
    "DefaultConnection": "${DATABASE_URL}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "Swagger": {
    "Enabled": true,
    "Title": "NotKrisp API",
    "Version": "v1",
    "Description": "API for managing meeting transcriptions, summaries, and tickets"
  }
}
