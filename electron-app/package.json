{
  "name": "electron-app",
  "version": "1.0.0",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "concurrently \"npm:watch-main\" \"npm:watch-renderer\" \"wait-on dist/main/main.js && electron .\"",
    "watch-main": "tsc --watch --project tsconfig.json --pretty",
    "watch-renderer": "tsc --watch --project tsconfig.json --pretty",
    "build": "tsc && npm run copy-assets",
    "electron": "electron .",
    "package": "electron-builder",
    "postbuild": "cpx \"src/renderer/**/*.{html,css,js,ico,png}\" dist/renderer/",
    "copy-assets": "copyfiles -u 2 src/assets/**/* dist/assets && copyfiles -u 2 src/renderer/*.css dist/renderer"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^22.15.2",
    "concurrently": "^9.1.2",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "bootstrap": "^5.3.5",
    "bootstrap-icons": "^1.11.3",
    "electron-store": "^10.0.1",
    "node-window-manager": "^2.2.4",
    "ps-list": "^8.1.1"
  }
}
